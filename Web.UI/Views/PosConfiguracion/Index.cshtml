@model Web.ApiClient.Dtos.Pos.PosConfiguracionVista
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Configuración POS";
    var config = Model.Configuracion;
    bool puedeActualizar = ViewBag.PuedeActualizar ?? false;
    string? errorCarga = ViewBag.ErrorCarga;
    var hayErrorCarga = !string.IsNullOrEmpty(errorCarga);
    // Sin la configuración actual no se edita ni se guarda: un PUT con los campos vacíos borraría la configuración real.
    var deshabilitado = !puedeActualizar || hayErrorCarga;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Configuración POS</h3>
    @if (puedeActualizar && !hayErrorCarga)
    {
        <button type="button" class="btn btn-primary" id="btnGuardarPosConfiguracion">
            <i class="fa-solid fa-floppy-disk me-1"></i>Guardar configuración
        </button>
    }
</div>

@if (hayErrorCarga)
{
    <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
        <div>
            <div>No se pudo cargar la configuración actual: @errorCarga</div>
            <div class="small">Los campos no se pueden modificar hasta que se cargue.</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger" id="btnReintentarPosConfiguracion">
            <i class="fa-solid fa-rotate-right me-1"></i>Reintentar
        </button>
    </div>
}
else
{
    <div id="posFaltantes" class="alert @(Model.Faltantes.Count > 0 ? "alert-warning" : "alert-success")" role="status">
        @if (Model.Faltantes.Count > 0)
        {
            <div class="fw-semibold mb-1">El POS todavía no puede vender. Falta completar:</div>
            <ul class="mb-0">
                @foreach (var faltante in Model.Faltantes)
                {
                    <li>@faltante</li>
                }
            </ul>
        }
        else
        {
            <span>La configuración del POS está completa.</span>
        }
    </div>
}

<div class="alert alert-info d-flex align-items-start gap-2" role="note">
    <i class="fa-solid fa-circle-info mt-1"></i>
    <span>No compartas estas series con facturas o pagos normales: el POS las usa en exclusiva.</span>
</div>

@if (!puedeActualizar && !hayErrorCarga)
{
    <div class="text-muted small mb-2">Solo tienes permiso de consulta: los campos no se pueden modificar.</div>
}

<div class="card card-modulo">
    <div class="card-body">
        <form id="formPosConfiguracion" novalidate>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="SerieFactura" class="form-label">Serie de factura del POS</label>
                    <select id="SerieFactura" class="form-select" disabled="@deshabilitado">
                        <option value="">-- Seleccione --</option>
                        @foreach (var o in (IEnumerable<SelectListItem>)ViewBag.SeriesFactura)
                        {
                            <option value="@o.Value" selected="@(o.Value == config.SerieFactura?.ToString())">@o.Text</option>
                        }
                    </select>
                    <span class="form-text">Series automáticas de facturas (subtipo «--»), no manuales ni bloqueadas.</span>
                </div>
                <div class="col-md-6">
                    <label for="SeriePago" class="form-label">Serie de pagos recibidos</label>
                    <select id="SeriePago" class="form-select" disabled="@deshabilitado">
                        <option value="">-- Seleccione --</option>
                        @foreach (var o in (IEnumerable<SelectListItem>)ViewBag.SeriesPago)
                        {
                            <option value="@o.Value" selected="@(o.Value == config.SeriePago?.ToString())">@o.Text</option>
                        }
                    </select>
                    <span class="form-text">Serie con la que el POS registra el cobro de cada venta.</span>
                </div>

                <div class="col-md-6">
                    <label for="CodAlmacen" class="form-label">Almacén</label>
                    <select id="CodAlmacen" class="form-select" disabled="@deshabilitado">
                        <option value="">-- Seleccione --</option>
                        @foreach (var o in (IEnumerable<SelectListItem>)ViewBag.Almacenes)
                        {
                            <option value="@o.Value" selected="@(o.Value == config.CodAlmacen)">@o.Text</option>
                        }
                    </select>
                    <span class="form-text">De este almacén sale la mercancía y se muestran las existencias.</span>
                </div>
                <div class="col-md-6">
                    <label for="CodigoImpuesto" class="form-label">Impuesto</label>
                    <select id="CodigoImpuesto" class="form-select" disabled="@deshabilitado">
                        <option value="">-- Seleccione --</option>
                        @foreach (var o in (IEnumerable<SelectListItem>)ViewBag.Impuestos)
                        {
                            <option value="@o.Value" selected="@(o.Value == config.CodigoImpuesto)">@o.Text</option>
                        }
                    </select>
                    <span class="form-text">Impuesto que se aplica a todas las líneas de la venta.</span>
                </div>

                <div class="col-md-6">
                    <label for="MonedaDoc" class="form-label">Moneda</label>
                    <select id="MonedaDoc" class="form-select" disabled="@deshabilitado">
                        <option value="">-- Seleccione --</option>
                        @foreach (var o in (IEnumerable<SelectListItem>)ViewBag.Monedas)
                        {
                            <option value="@o.Value" selected="@(o.Value == config.MonedaDoc)">@o.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="FormaPagoEfectivo" class="form-label">Forma de pago en efectivo</label>
                    <select id="FormaPagoEfectivo" class="form-select" disabled="@deshabilitado">
                        <option value="">-- Seleccione --</option>
                        @foreach (var o in (IEnumerable<SelectListItem>)ViewBag.FormasPago)
                        {
                            <option value="@o.Value" selected="@(o.Value == config.FormaPagoEfectivo)">@o.Text</option>
                        }
                    </select>
                    <span class="form-text">Solo formas de pago activas. Es la que se usa por defecto al cobrar.</span>
                </div>

                <div class="col-md-6 position-relative">
                    <label for="ClienteDefectoTexto" class="form-label">Cliente por defecto</label>
                    <input type="text" id="ClienteDefectoTexto" class="form-control" placeholder="Buscar cliente por código o nombre..." autocomplete="off"
                           value="@ViewBag.TextoCliente" readonly="@deshabilitado" />
                    <input type="hidden" id="ClienteDefecto" value="@config.ClienteDefecto" />
                    <div class="invalid-feedback" id="ClienteDefectoError">Selecciona una opción de la lista o borra el texto.</div>
                    <ul class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1055; max-height: 220px; overflow-y: auto;" id="ClienteDefectoResultados"></ul>
                    <span class="form-text">Cliente (p. ej. «Consumidor final») de las ventas en que no se elige otro.</span>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/pos-configuracion.js" asp-append-version="true"></script>
}
