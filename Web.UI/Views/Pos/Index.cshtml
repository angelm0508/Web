@model Web.UI.Models.PosPantallaModelo
@using System.Globalization
@{
    ViewData["Title"] = "Punto de venta";
    var listo = string.IsNullOrEmpty(Model.ErrorCarga) && Model.Faltantes.Count == 0;
    int[] billetes = { 10, 20, 50, 100, 200 };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pos.css" asp-append-version="true" />
}

@if (!listo)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Punto de venta</h3>
    </div>
    <div class="alert alert-warning" role="alert" id="posSinConfiguracion">
        @if (!string.IsNullOrEmpty(Model.ErrorCarga))
        {
            <div class="fw-semibold">No se pudo cargar la configuración del POS: @Model.ErrorCarga</div>
        }
        else
        {
            <div class="fw-semibold mb-1">El POS todavía no puede vender. Falta completar:</div>
            <ul class="mb-0">
                @foreach (var faltante in Model.Faltantes)
                {
                    <li>@faltante</li>
                }
            </ul>
        }
        @if (Model.PuedeConfigurar)
        {
            <a class="btn btn-sm btn-outline-primary mt-3" href="/PosConfiguracion"><i class="fa-solid fa-gear me-1"></i>Ir a la configuración del POS</a>
        }
        else
        {
            <div class="small mt-2">Pide a un administrador que complete la configuración del POS.</div>
        }
    </div>
}
else
{
    <div id="posApp"
         data-cliente-codigo="@Model.ClienteCodigo"
         data-cliente-nombre="@Model.ClienteNombre"
         data-cliente-nit="@Model.ClienteNit"
         data-tasa="@Model.TasaImpuesto.ToString(CultureInfo.InvariantCulture)"
         data-tasa-disponible="@(Model.TasaDisponible ? "true" : "false")"
         data-forma-efectivo="@Model.FormaPagoEfectivo"
         data-puede-cobrar="@(Model.PuedeCobrar ? "true" : "false")">

        <div id="posPantalla" class="pos-pantalla">
            <!-- Columna izquierda: buscador y venta en curso -->
            <section class="pos-columna-venta" aria-label="Venta en curso">
                <div class="pos-barra">
                    <div class="pos-buscador position-relative flex-grow-1">
                        <label for="posBuscador" class="visually-hidden">Buscar artículo por código, código de barras o nombre</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="fa-solid fa-barcode"></i></span>
                            <input type="text" id="posBuscador" class="form-control" autocomplete="off" autofocus
                                   placeholder="Código, código de barras o nombre (F2)"
                                   role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="posSugerencias" />
                        </div>
                        <ul id="posSugerencias" class="list-group pos-sugerencias shadow d-none" role="listbox" aria-label="Sugerencias"></ul>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-lg pos-btn-tactil" id="posBtnPantallaCompleta" title="Pantalla completa" aria-label="Pantalla completa">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                </div>
                <div id="posMensajeBuscador" class="pos-mensaje small d-none" role="status" aria-live="polite"></div>

                <div class="pos-lineas card">
                    <div class="table-responsive pos-lineas-scroll">
                        <table class="table table-hover align-middle mb-0" id="posTablaLineas">
                            <thead class="sticky-top">
                                <tr>
                                    <th>Artículo</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Importe</th>
                                    <th class="text-center"><span class="visually-hidden">Quitar</span></th>
                                </tr>
                            </thead>
                            <tbody id="posLineas"></tbody>
                        </table>
                        <div id="posSinLineas" class="pos-vacio text-muted">
                            <i class="fa-solid fa-cart-shopping fa-2x mb-2"></i>
                            <div>Escanea o busca un artículo para empezar la venta.</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Columna derecha: cliente, totales, acciones y rápidos -->
            <aside class="pos-columna-cobro" aria-label="Cobro">
                <div class="card pos-cliente">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="text-truncate">
                                <div class="small text-muted">Cliente</div>
                                <div class="fw-semibold text-truncate" id="posClienteNombre"></div>
                                <div class="small text-muted font-monospace" id="posClienteCodigo"></div>
                            </div>
                            <button type="button" class="btn btn-outline-primary pos-btn-tactil" id="posBtnCambiarCliente">
                                <i class="fa-solid fa-user-pen me-1"></i>Cambiar <span class="pos-atajo">F4</span>
                            </button>
                        </div>
                        <div class="mt-2">
                            <label for="posNit" class="form-label small text-muted mb-0">NIT del documento</label>
                            <input type="text" id="posNit" class="form-control" maxlength="15" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="card pos-totales" aria-live="polite">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between"><span class="text-muted">Subtotal</span><span class="font-monospace" id="posSubtotal">0.00</span></div>
                        <div class="d-flex justify-content-between"><span class="text-muted">IVA@(Model.TasaDisponible ? $" ({Model.TasaImpuesto.ToString("0.##", CultureInfo.InvariantCulture)} %)" : "")</span><span class="font-monospace" id="posImpuesto">0.00</span></div>
                        <div class="d-flex justify-content-between align-items-baseline pos-total">
                            <span>Total <span class="small text-muted">@Model.Moneda (estimado)</span></span>
                            <span class="font-monospace" id="posTotal">0.00</span>
                        </div>
                        @if (!Model.TasaDisponible)
                        {
                            <div class="small text-warning">No se pudo leer la tasa del impuesto: el total estimado no incluye IVA. El total real lo calcula el sistema al cobrar.</div>
                        }
                        <div class="small text-muted">Precios e impuesto definitivos al cobrar.</div>
                    </div>
                </div>

                <div class="pos-acciones">
                    <button type="button" class="btn btn-success btn-lg pos-btn-cobrar" id="posBtnCobrar" disabled="@(!Model.PuedeCobrar)"
                            title="@(Model.PuedeCobrar ? "Cobrar la venta" : "No tienes permiso para cobrar")">
                        <i class="fa-solid fa-cash-register me-2"></i>Cobrar <span class="pos-atajo">F9</span>
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill pos-btn-tactil" id="posBtnNuevaVenta">
                            <i class="fa-solid fa-broom me-1"></i>Nueva venta <span class="pos-atajo">Esc</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary flex-fill pos-btn-tactil" id="posBtnVentasDia">
                            <i class="fa-solid fa-list me-1"></i>Ventas del día
                        </button>
                    </div>
                    @if (!Model.PuedeCobrar)
                    {
                        <div class="small text-muted">Solo tienes permiso de consulta: no puedes cobrar ventas.</div>
                    }
                </div>

                <div class="pos-rapidos-contenedor">
                    <div class="small text-muted mb-1">Artículos rápidos</div>
                    <div id="posRapidos" class="pos-rapidos" aria-label="Artículos rápidos">
                        <div class="text-muted small">Cargando...</div>
                    </div>
                </div>
            </aside>
        </div>

        <!-- Modal: cambiar cliente (F4) -->
        <div class="modal fade" id="posModalCliente" tabindex="-1" aria-labelledby="posModalClienteTitulo" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="posModalClienteTitulo">Cambiar cliente</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="position-relative">
                            <label for="posClienteBuscar" class="form-label">Buscar cliente por código o nombre</label>
                            <input type="text" id="posClienteBuscar" class="form-control form-control-lg" autocomplete="off" placeholder="Escribe al menos 2 caracteres..." />
                            <input type="hidden" id="posClienteBuscarCodigo" />
                            <div class="invalid-feedback d-none" id="posClienteBuscarError">Elige un cliente de la lista.</div>
                            <ul class="list-group position-absolute w-100 shadow-sm d-none pos-lista-clientes" id="posClienteSugerencias"></ul>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" id="posBtnClienteDefecto">Usar el cliente por defecto</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: cobro (F9) -->
        <div class="modal fade" id="posModalCobro" tabindex="-1" aria-labelledby="posModalCobroTitulo" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="posModalCobroTitulo">Cobrar</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="pos-cobro-resumen">
                            <div><div class="small text-muted">Total (estimado)</div><div class="pos-cobro-cifra font-monospace" id="posCobroTotal">0.00</div></div>
                            <div><div class="small text-muted">Pagado</div><div class="pos-cobro-cifra font-monospace" id="posCobroPagado">0.00</div></div>
                            <div><div class="small text-muted" id="posCobroDiferenciaEtiqueta">Falta</div><div class="pos-cobro-cifra font-monospace" id="posCobroDiferencia">0.00</div></div>
                        </div>

                        <table class="table align-middle mt-3 mb-2" id="posTablaPagos">
                            <thead>
                                <tr>
                                    <th>Forma de pago</th>
                                    <th style="width: 10rem">Importe</th>
                                    <th>Datos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var forma in Model.FormasPago)
                                {
                                    var esEfectivo = string.Equals(forma.Codigo, Model.FormaPagoEfectivo, StringComparison.OrdinalIgnoreCase);
                                    <tr class="pos-fila-pago" data-codigo="@forma.Codigo" data-tipo="@forma.TipoDato" data-nombre="@forma.Nombre" data-efectivo="@(esEfectivo ? "S" : "N")">
                                        <th scope="row">@forma.Nombre</th>
                                        <td>
                                            <input type="number" class="form-control text-end pos-monto" min="0" step="0.01" inputmode="decimal" aria-label="Importe en @forma.Nombre" />
                                        </td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                @switch (forma.TipoDato)
                                                {
                                                    case "C":
                                                        <input type="text" class="form-control form-control-sm pos-referencia" maxlength="50" placeholder="Nº de cheque" aria-label="Número de cheque" />
                                                        <input type="text" class="form-control form-control-sm pos-banco" maxlength="60" placeholder="Banco" aria-label="Banco" />
                                                        <input type="date" class="form-control form-control-sm pos-fecha-cheque" aria-label="Fecha del cheque" />
                                                        break;
                                                    case "T":
                                                        <input type="text" class="form-control form-control-sm pos-referencia" maxlength="50" placeholder="Referencia" aria-label="Referencia de la transferencia" />
                                                        <input type="text" class="form-control form-control-sm pos-banco" maxlength="60" placeholder="Banco (opcional)" aria-label="Banco" />
                                                        break;
                                                    case "J":
                                                        <input type="text" class="form-control form-control-sm pos-referencia" maxlength="50" placeholder="Autorización / últimos 4" aria-label="Autorización de la tarjeta" />
                                                        break;
                                                    default:
                                                        <span class="text-muted small">—</span>
                                                        break;
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="small text-muted me-1">Billetes (efectivo):</span>
                            @foreach (var billete in billetes)
                            {
                                <button type="button" class="btn btn-outline-success pos-btn-tactil pos-billete" data-valor="@billete">+@billete</button>
                            }
                            <button type="button" class="btn btn-outline-secondary pos-btn-tactil" id="posBtnExacto" title="Efectivo exacto por lo que falta">Exacto</button>
                            <button type="button" class="btn btn-outline-secondary pos-btn-tactil" id="posBtnLimpiarEfectivo" title="Poner el efectivo en cero">Limpiar</button>
                        </div>
                        <div id="posCobroMensaje" class="small mt-2 text-danger" role="status" aria-live="polite"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Volver</button>
                        <button type="button" class="btn btn-success btn-lg" id="posBtnConfirmar" disabled>
                            <i class="fa-solid fa-check me-1"></i>Confirmar <span class="pos-atajo">Enter</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: ticket (venta o reimpresión) -->
        <div class="modal fade" id="posModalTicket" tabindex="-1" aria-labelledby="posModalTicketTitulo" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable pos-modal-ticket">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="posModalTicketTitulo">Ticket</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div id="ticketImprimible"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary pos-btn-tactil" id="posBtnImprimir"><i class="fa-solid fa-print me-1"></i>Imprimir</button>
                        <button type="button" class="btn btn-primary pos-btn-tactil" id="posBtnTicketCerrar">Nueva venta <span class="pos-atajo">Enter</span></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal: ventas del día -->
        <div class="modal fade" id="posModalVentasDia" tabindex="-1" aria-labelledby="posModalVentasDiaTitulo" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="posModalVentasDiaTitulo">Ventas del día</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div id="posVentasDiaEstado" class="text-muted small mb-2"></div>
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Hora</th>
                                    <th>Serie-número</th>
                                    <th>Cliente</th>
                                    <th class="text-end">Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="posVentasDiaCuerpo"></tbody>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (listo)
    {
        <script src="~/js/pos.js" asp-append-version="true"></script>
    }
}
