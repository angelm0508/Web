@model Web.ApiClient.Dtos.GrupoUnidadMedidaArticulo.GrupoUnidadMedidaArticuloCrearDTO
@{
    bool esEdicion = ViewBag.EsEdicion ?? false;
    int id = ViewBag.Id ?? 0;
}

<div class="modal-header">
    <h5 class="modal-title">@(esEdicion ? "Editar grupo de unidad de medida" : "Nuevo grupo de unidad de medida")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <form id="formGrupoUnidadMedida" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="BaseMedida" class="form-label">Unidad de medida base</label>
                <select asp-for="BaseMedida" id="selectBaseMedida" class="form-select" asp-items="ViewBag.Unidades">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="BaseMedida" class="text-danger small"></span>
            </div>
        </div>
    </form>

    <hr />
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Detalle de unidades del grupo</h6>
        <button type="button" class="btn btn-sm btn-outline-primary" id="btnNuevaLinea">
            <i class="fa-solid fa-plus me-1"></i>Agregar línea
        </button>
    </div>

    @if (!esEdicion)
    {
        <p class="text-muted small">Las líneas agregadas aquí se guardarán junto con el grupo.</p>
    }

    <div class="table-responsive">
        <table id="tblDetalleGrupoUnidadMedida" class="table table-sm table-hover align-middle w-100" data-grupo="@id" data-es-edicion="@esEdicion.ToString().ToLower()">
            <thead>
                <tr>
                    <th>Unidad</th>
                    <th>Cantidad alternativa</th>
                    <th>Cantidad base</th>
                    <th>Unidad medida base</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div id="panelLineaDetalle" class="border rounded p-3 mb-2 d-none">
        <form id="formLineaDetalle">
            <input type="hidden" id="detNumLineaOriginal" value="" />
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label">Unidad de medida</label>
                    <select name="MedidaEntry" id="detMedidaEntry" class="form-select" asp-items="ViewBag.Unidades">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Cantidad alternativa</label>
                    <input name="CantAlternativa" id="detCantAlternativa" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Cantidad base</label>
                    <input name="CantBase" id="detCantBase" type="number" step="0.01" class="form-control" />
                </div>
            </div>
            <div class="text-end mt-2">
                <button type="button" class="btn btn-sm btn-secondary" id="btnCancelarLinea">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnGuardarLinea">Guardar línea</button>
            </div>
        </form>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnGuardarGrupoUnidadMedida" data-edicion="@esEdicion.ToString().ToLower()" data-id="@id">
        <i class="fa-solid fa-floppy-disk me-1"></i>Guardar
    </button>
</div>
