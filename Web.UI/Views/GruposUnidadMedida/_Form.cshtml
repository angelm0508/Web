@model Web.ApiClient.Dtos.GrupoUnidadMedidaArticulo.GrupoUnidadMedidaArticuloCrearDTO
@{
    bool esEdicion = ViewBag.EsEdicion ?? false;
    int id = ViewBag.Id ?? 0;
}

<div class="modal-header">
    <h5 class="modal-title">@(esEdicion ? "Editar grupo de unidad de medida" : "Nuevo grupo de unidad de medida")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <form id="formGrupoUnidadMedida" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BaseMedida" class="form-label"></label>
                <select asp-for="BaseMedida" class="form-select" asp-items="ViewBag.Unidades">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label asp-for="Bloqueado" class="form-label"></label>
                <select asp-for="Bloqueado" class="form-select">
                    <option value="N">No</option>
                    <option value="S">Sí</option>
                </select>
            </div>
        </div>
    </form>

    @if (esEdicion)
    {
        <hr />
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Detalle de unidades del grupo</h6>
            <button type="button" class="btn btn-sm btn-outline-primary" id="btnNuevaLinea">
                <i class="fa-solid fa-plus me-1"></i>Agregar línea
            </button>
        </div>

        <div class="table-responsive">
            <table id="tblDetalleGrupoUnidadMedida" class="table table-sm table-hover align-middle w-100" data-grupo="@id">
                <thead>
                    <tr>
                        <th>Unidad</th>
                        <th>Cant. alternativa</th>
                        <th>Cant. base</th>
                        <th>Factor peso</th>
                        <th>Factor UDF</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="panelLineaDetalle" class="border rounded p-3 mb-2 d-none">
            <form id="formLineaDetalle">
                <input type="hidden" name="GrpMedidaEntry" id="detGrpMedidaEntry" value="@id" />
                <input type="hidden" id="detNumLineaOriginal" value="" />
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">Unidad</label>
                        <select name="MedidaEntry" id="detMedidaEntry" class="form-select" asp-items="ViewBag.Unidades">
                            <option value="">-- Seleccione --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Cant. alternativa</label>
                        <input name="CantAlternativa" id="detCantAlternativa" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Cant. base</label>
                        <input name="CantBase" id="detCantBase" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Factor peso</label>
                        <input name="PesoFactor" id="detPesoFactor" type="number" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Factor UDF</label>
                        <input name="UdfFactor" id="detUdfFactor" type="number" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Activo</label>
                        <select name="Activo" id="detActivo" class="form-select">
                            <option value="S">Sí</option>
                            <option value="N">No</option>
                        </select>
                    </div>
                </div>
                <div class="text-end mt-2">
                    <button type="button" class="btn btn-sm btn-secondary" id="btnCancelarLinea">Cancelar</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnGuardarLinea">Guardar línea</button>
                </div>
            </form>
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnGuardarGrupoUnidadMedida" data-edicion="@esEdicion.ToString().ToLower()" data-id="@id">
        <i class="fa-solid fa-floppy-disk me-1"></i>Guardar
    </button>
</div>
