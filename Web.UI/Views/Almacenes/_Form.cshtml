@using System.Text.Json
@model Web.ApiClient.Dtos.Almacen.AlmacenCrearDTO
@{
    bool esEdicion = ViewBag.EsEdicion ?? false;
    var opcionesJson = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<div class="modal-header">
    <h5 class="modal-title">@(esEdicion ? "Editar almacén" : "Nuevo almacén")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <form id="formAlmacen" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" readonly="@esEdicion" />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>
            <div class="col-md-2">
                <label asp-for="Activo" class="form-label"></label>
                <select asp-for="Activo" class="form-select">
                    <option value="S">Sí</option>
                    <option value="N">No</option>
                </select>
                <span asp-validation-for="Activo" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Calle" class="form-label"></label>
                <input asp-for="Calle" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="CodigoPostal" class="form-label"></label>
                <input asp-for="CodigoPostal" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Bloqueado" class="form-label"></label>
                <select asp-for="Bloqueado" class="form-select">
                    <option value="N">No</option>
                    <option value="S">Sí</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="Pais" class="form-label"></label>
                <select asp-for="Pais" class="form-select" asp-items="ViewBag.Paises" id="selectPais">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Departamento" class="form-label"></label>
                <select asp-for="Departamento" class="form-select" id="selectDepartamento">
                    <option value="">-- Seleccione un país primero --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Municipio" class="form-label"></label>
                <select asp-for="Municipio" class="form-select" id="selectMunicipio">
                    <option value="">-- Seleccione un departamento primero --</option>
                </select>
            </div>
        </div>
    </form>

    <script id="datosUbicacion" type="application/json">
        {
            "departamentos": @Html.Raw(JsonSerializer.Serialize(ViewBag.Departamentos, opcionesJson)),
            "municipios": @Html.Raw(JsonSerializer.Serialize(ViewBag.Municipios, opcionesJson)),
            "departamentoActual": @Html.Raw(JsonSerializer.Serialize(Model.Departamento, opcionesJson)),
            "municipioActual": @Html.Raw(JsonSerializer.Serialize(Model.Municipio, opcionesJson))
        }
    </script>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnGuardarAlmacen" data-edicion="@esEdicion.ToString().ToLower()" data-codigo="@Model.Codigo">
        <i class="fa-solid fa-floppy-disk me-1"></i>Guardar
    </button>
</div>
