@model Web.UI.Models.Cuenta.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:100vh; background:#1e2530;">
    <div class="card shadow-lg border-0" style="width: 100%; max-width: 380px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="fa-solid fa-cubes fa-2x text-primary"></i>
                <h4 class="mt-2 mb-0">Sistema de Gestión</h4>
                <p class="text-muted small">Inicia sesión para continuar</p>
            </div>

            <form asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label"></label>
                    <input asp-for="Usuario" class="form-control" autofocus autocomplete="username" />
                    <span asp-validation-for="Usuario" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Ingresar
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
