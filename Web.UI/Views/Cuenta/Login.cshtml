@model Web.UI.Models.Cuenta.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card">
        <div class="login-hero">
            <div class="login-hero-brand">
                <span class="login-hero-badge"><i class="fa-solid fa-cubes"></i></span>
                Sistema de Gestión
            </div>
            <div>
                <h2 class="login-hero-title">Tu negocio completo, en una sola pantalla.</h2>
                <p class="login-hero-text">Inventario, socios de negocio, cotizaciones y numeración de documentos, todo sincronizado en un solo lugar.</p>
            </div>
            <div class="login-hero-footer">Sistema de Gestión</div>
        </div>
        <div class="login-form-panel">
            <h1 class="login-form-title">Iniciar sesión</h1>
            <p class="login-form-subtitle">Inicia sesión para continuar</p>

            <form asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label"></label>
                    <input asp-for="Usuario" class="form-control" autofocus autocomplete="username" />
                    <span asp-validation-for="Usuario" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Ingresar
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
