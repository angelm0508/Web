@model Web.ApiClient.Dtos.UnidadMedidaArticulo.UnidadMedidaArticuloCrearDTO
@{
    bool esEdicion = ViewBag.EsEdicion ?? false;
    int id = ViewBag.Id ?? 0;
}

<div class="modal-header">
    <h5 class="modal-title">@(esEdicion ? "Editar unidad de medida" : "Nueva unidad de medida")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <form id="formUnidadMedida" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" readonly="@esEdicion" />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="Largo" class="form-label"></label>
                <input asp-for="Largo" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Ancho" class="form-label"></label>
                <input asp-for="Ancho" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Altura" class="form-label"></label>
                <input asp-for="Altura" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Volumen" class="form-label"></label>
                <input asp-for="Volumen" type="number" step="0.01" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="Peso" class="form-label"></label>
                <input asp-for="Peso" type="number" step="0.01" class="form-control" />
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnGuardarUnidadMedida" data-edicion="@esEdicion.ToString().ToLower()" data-id="@id">
        <i class="fa-solid fa-floppy-disk me-1"></i>Guardar
    </button>
</div>
