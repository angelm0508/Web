@using System.Text.Json
@model Web.ApiClient.Dtos.SalidaMercancia.SalidaMercanciaCrearDTO
@{
    bool esEdicion = ViewBag.EsEdicion ?? false;
    var opcionesJson = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<div class="modal-header">
    <h5 class="modal-title">@(esEdicion ? "Editar salida de mercancía" : "Nueva salida de mercancía")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <form id="formSalidaMercancia" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

        <div class="row g-3">
            @if (!esEdicion)
            {
                <div class="col-md-3">
                    <label class="form-label">Serie</label>
                    <select id="selectSerieSalidaMercancia" class="form-select" data-serie-defecto="@ViewBag.SerieDefecto"></select>
                    <span class="form-text">Si eliges una serie distinta de "Manual", el número se genera solo al guardar.</span>
                </div>
            }
            else
            {
                <div class="col-md-3">
                    <label class="form-label">Serie</label>
                    <input class="form-control" value="@ViewBag.NombreSerieActual" disabled />
                </div>
            }
            <div class="col-md-3">
                <label asp-for="NumDoc" class="form-label">No. documento</label>
                <input asp-for="NumDoc" type="number" class="form-control" readonly="@esEdicion" />
                <span asp-validation-for="NumDoc" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha documento</label>
                <input type="date" name="FechaDoc" id="FechaDoc" class="form-control" value="@Model.FechaDoc?.ToString("yyyy-MM-dd")" readonly="@esEdicion" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Fecha contabilización</label>
                <input type="date" name="FechaContab" id="FechaContab" class="form-control" value="@Model.FechaContab?.ToString("yyyy-MM-dd")" readonly="@esEdicion" />
            </div>

            <div class="col-md-6">
                <label asp-for="Referencia" class="form-label">Referencia</label>
                <input asp-for="Referencia" class="form-control" readonly="@esEdicion" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Total documento</label>
                <input id="TotalDoc" class="form-control" value="" disabled />
            </div>

            <div class="col-12">
                <label asp-for="Comentario" class="form-label">Comentario</label>
                <textarea asp-for="Comentario" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </form>

    <hr />
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Detalle</h6>
        @if (!esEdicion)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" id="btnNuevaLinea">
                <i class="fa-solid fa-plus me-1"></i>Agregar línea
            </button>
        }
    </div>

    @if (!esEdicion)
    {
        <p class="text-muted small">Las líneas agregadas aquí se guardarán junto con la salida de mercancía. El costo de cada línea lo calcula el servidor (costo promedio móvil) al asentar.</p>
    }
    else
    {
        <p class="text-muted small">El documento ya está asentado en inventario. Solo se puede modificar el comentario; las líneas son de solo lectura.</p>
    }

    <div class="table-responsive">
        <table id="tblDetalleSalidaMercancia" class="table table-sm table-hover align-middle w-100" data-entry="@ViewBag.EntryActual" data-es-edicion="@esEdicion.ToString().ToLower()">
            <thead>
                <tr>
                    <th>Artículo</th>
                    <th>Descripción</th>
                    <th>Cantidad</th>
                    <th>Costo unitario</th>
                    <th>Total línea</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div id="panelLineaDetalle" class="border rounded p-3 mb-2 d-none">
        <form id="formLineaDetalle">
            <input type="hidden" id="detNoLineaOriginal" value="" />
            <div class="row g-2">
                <div class="col-md-6 position-relative">
                    <label class="form-label">Artículo</label>
                    <input type="text" id="detCodArticuloTexto" class="form-control" placeholder="Buscar por código o nombre..." autocomplete="off" />
                    <input type="hidden" id="detCodArticulo" />
                    <div class="invalid-feedback" id="detCodArticuloError">Selecciona una opción de la lista o borra el texto.</div>
                    <ul class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1055; max-height: 220px; overflow-y: auto;" id="detCodArticuloResultados"></ul>
                </div>
                <div class="col-md-6 position-relative">
                    <label class="form-label">Almacén</label>
                    <input type="text" id="detCodAlmacenTexto" class="form-control" placeholder="Buscar por código o nombre..." autocomplete="off" />
                    <input type="hidden" name="CodAlmacen" id="detCodAlmacen" />
                    <div class="invalid-feedback" id="detCodAlmacenError">Selecciona una opción de la lista o borra el texto.</div>
                    <ul class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1055; max-height: 220px; overflow-y: auto;" id="detCodAlmacenResultados"></ul>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Descripción</label>
                    <input name="Descripcion" id="detDescripcion" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input name="Cantidad" id="detCantidad" type="number" step="0.01" class="form-control" value="1" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Costo unitario</label>
                    <input name="CostoUnitario" id="detCostoUnitario" type="number" step="0.000001" class="form-control" readonly />
                    <span class="form-text">Informativo. El servidor lo calcula al costo promedio móvil.</span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Total línea</label>
                    <input id="detTotalLinea" type="number" step="0.01" class="form-control" readonly />
                </div>
            </div>
            <div class="text-end mt-2">
                <button type="button" class="btn btn-sm btn-secondary" id="btnCancelarLinea">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnGuardarLinea">Guardar línea</button>
            </div>
        </form>
    </div>

    @if (!esEdicion)
    {
        <script id="datosSeriesSalidaMercancia" type="application/json">
            @Html.Raw(JsonSerializer.Serialize(ViewBag.SeriesSalidaMercancia, opcionesJson))
        </script>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    @if (esEdicion && (Model.Cancelado ?? "N") != "S")
    {
        <button type="button" class="btn btn-outline-danger" id="btnCancelarDocSalidaMercancia" data-entry="@ViewBag.EntryActual">
            <i class="fa-solid fa-ban me-1"></i>Cancelar documento
        </button>
    }
    @if ((Model.Cancelado ?? "N") != "S")
    {
        <button type="button" class="btn btn-primary" id="btnGuardarSalidaMercancia" data-edicion="@esEdicion.ToString().ToLower()" data-entry="@ViewBag.EntryActual">
            <i class="fa-solid fa-floppy-disk me-1"></i>Guardar
        </button>
    }
</div>
