@{
    ViewData["Title"] = "Numeración de documentos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Numeración de documentos</h3>
</div>

<div class="card card-modulo">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblNumeracionDocumento" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Nombre serie defecto</th>
                        <th>Primer número</th>
                        <th>Número siguiente</th>
                        <th>Último número</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFormulario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="contenidoModal">
            <!-- se carga por AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/numeracionDocumento.js" asp-append-version="true"></script>
}
