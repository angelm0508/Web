@model Web.UI.Models.Home.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="mb-4">Dashboard</h3>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon bg-primary-subtle text-primary"><i class="fa-solid fa-box"></i></div>
                <div>
                    <div class="text-muted small">Artículos</div>
                    <div class="fs-4 fw-semibold">@Model.TotalArticulos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon bg-success-subtle text-success"><i class="fa-solid fa-warehouse"></i></div>
                <div>
                    <div class="text-muted small">Almacenes</div>
                    <div class="fs-4 fw-semibold">@Model.TotalAlmacenes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon bg-warning-subtle text-warning"><i class="fa-solid fa-handshake"></i></div>
                <div>
                    <div class="text-muted small">Socios de Negocio</div>
                    <div class="fs-4 fw-semibold">@Model.TotalSociosNegocio</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon bg-info-subtle text-info"><i class="fa-solid fa-location-dot"></i></div>
                <div>
                    <div class="text-muted small">Direcciones</div>
                    <div class="fs-4 fw-semibold">@Model.TotalDireccionesSocioNegocio</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold"><i class="fa-solid fa-box me-2"></i>Gestión de Artículos</div>
            <div class="list-group list-group-flush">
                <a asp-controller="Articulos" asp-action="Index" class="list-group-item list-group-item-action">Artículos</a>
                <a asp-controller="Fabricantes" asp-action="Index" class="list-group-item list-group-item-action">Fabricantes</a>
                <a asp-controller="GruposArticulo" asp-action="Index" class="list-group-item list-group-item-action">Grupos</a>
                <a asp-controller="Medidas" asp-action="Index" class="list-group-item list-group-item-action">Medidas</a>
                <a asp-controller="Almacenes" asp-action="Index" class="list-group-item list-group-item-action">Almacenes</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white fw-semibold"><i class="fa-solid fa-handshake me-2"></i>Socios de Negocio</div>
            <div class="list-group list-group-flush">
                <a asp-controller="SociosNegocio" asp-action="Index" class="list-group-item list-group-item-action">Socios de Negocio</a>
                <a asp-controller="GruposSn" asp-action="Index" class="list-group-item list-group-item-action">Grupos</a>
                <a asp-controller="ListadosPrecio" asp-action="Index" class="list-group-item list-group-item-action">Listado de Precios</a>
                <a asp-controller="Direcciones" asp-action="Index" class="list-group-item list-group-item-action">Direcciones</a>
            </div>
        </div>
    </div>
</div>
