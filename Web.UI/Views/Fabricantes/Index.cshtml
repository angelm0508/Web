@{
    ViewData["Title"] = "Fabricantes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Fabricantes</h3>
    @if (User.TienePermiso("Fabricantes", Accion.Agregar))
    {
        <button type="button" class="btn btn-primary" id="btnNuevo">
            <i class="fa-solid fa-plus me-1"></i>Nuevo
        </button>
    }
</div>

<div class="card card-modulo">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblFabricantes" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFormulario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="contenidoModal">
            <!-- se carga por AJAX -->
        </div>
    </div>
</div>

<script id="datosPermisosFabricantes" type="application/json">
    { "actualizar": @(User.TienePermiso("Fabricantes", Accion.Actualizar) ? "true" : "false"),
      "eliminar": @(User.TienePermiso("Fabricantes", Accion.Eliminar) ? "true" : "false") }
</script>

@section Scripts {
    <script src="~/js/fabricantes.js" asp-append-version="true"></script>
}
