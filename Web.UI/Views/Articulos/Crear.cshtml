@using System.Text.Json
@model Web.ApiClient.Dtos.Articulo.ArticuloCrearDTO
@{
    ViewData["Title"] = "Nuevo artículo";
    var opcionesJson = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<nav class="small text-muted mb-2">
    <a asp-controller="Articulos" asp-action="Index">Artículos</a>
    <i class="fa-solid fa-chevron-right mx-1" style="font-size:.65rem"></i>
    <span>Nuevo artículo</span>
</nav>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
    <div>
        <h1 class="h4 mb-1">Nuevo artículo</h1>
        <p class="text-muted small mb-0">La serie es obligatoria <span class="text-danger">*</span> para poder registrarlo; el código solo si eliges la serie "Manual" (en las demás, se genera al guardar).</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Articulos" asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
        <button type="button" class="btn btn-primary btn-sm" id="btnGuardarArticuloPagina">
            <i class="fa-solid fa-check me-1"></i>Guardar artículo
        </button>
    </div>
</div>

<form id="formArticuloCrear" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabGeneral" type="button">General</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPrecios" type="button">Precios</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabInventario" type="button">Inventario</button>
        </li>
    </ul>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="tabGeneral">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h6 mb-1">Identificación</h2>
                            <p class="small text-muted mb-3">Cómo se llama y cómo se encuentra este artículo en el sistema.</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Serie <span class="text-danger">*</span></label>
                                    <select id="selectSerieArticulo" class="form-select"></select>
                                    <span class="form-text">Si eliges una serie distinta de "Manual", el código se genera solo al guardar.</span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Codigo" class="form-label"></label>
                                    <input asp-for="Codigo" class="form-control" />
                                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                                </div>
                                <div class="col-md-8">
                                    <label asp-for="Nombre" class="form-label"></label>
                                    <input asp-for="Nombre" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="FabricanteEntry" class="form-label"></label>
                                    <select asp-for="FabricanteEntry" class="form-select" asp-items="ViewBag.Fabricantes">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CodigoGrupo" class="form-label"></label>
                                    <select asp-for="CodigoGrupo" class="form-select" asp-items="ViewBag.Grupos">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CodigoGrpUnidadMedida" class="form-label"></label>
                                    <select asp-for="CodigoGrpUnidadMedida" class="form-select" asp-items="ViewBag.GruposMedida">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Comentarios" class="form-label"></label>
                                    <textarea asp-for="Comentarios" class="form-control" rows="2"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tabPrecios">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h6 mb-1">Precios</h2>
                            <p class="small text-muted mb-3">Precio unitario de venta del artículo.</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="PrecioUnitario" class="form-label"></label>
                                    <input asp-for="PrecioUnitario" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tabInventario">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h6 mb-1">Inventario</h2>
                            <p class="small text-muted mb-3">Existencias, mínimos/máximos y almacén por defecto.</p>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="CantDisponible" class="form-label"></label>
                                    <input asp-for="CantDisponible" type="number" step="0.01" class="form-control" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Minimo" class="form-label"></label>
                                    <input asp-for="Minimo" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Maximo" class="form-label"></label>
                                    <input asp-for="Maximo" type="number" step="0.01" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="AlmacenDefecto" class="form-label"></label>
                                    <input asp-for="AlmacenDefecto" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Activo" class="form-label"></label>
                                    <select asp-for="Activo" class="form-select">
                                        <option value="S">Sí</option>
                                        <option value="N">No</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ArticuloCompra" class="form-label"></label>
                                    <select asp-for="ArticuloCompra" class="form-select">
                                        <option value="S">Sí</option>
                                        <option value="N">No</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ArticuloVenta" class="form-label"></label>
                                    <select asp-for="ArticuloVenta" class="form-select">
                                        <option value="S">Sí</option>
                                        <option value="N">No</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 mb-2">Recomendado completar</h2>
                    <div class="d-flex flex-column gap-2 small" id="listaChecklistArticulo">
                        <div class="d-flex align-items-center gap-2" data-check="Nombre">
                            <i class="fa-regular fa-circle text-muted"></i><span>Nombre del artículo</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" data-check="CodigoGrupo">
                            <i class="fa-regular fa-circle text-muted"></i><span>Grupo</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" data-check="PrecioUnitario">
                            <i class="fa-regular fa-circle text-muted"></i><span>Precio unitario</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" data-check="AlmacenDefecto">
                            <i class="fa-regular fa-circle text-muted"></i><span>Almacén por defecto</span>
                        </div>
                    </div>
                    <p class="small text-muted mt-3 mb-0">Puedes guardar sin completarlos; quedan pendientes para después.</p>
                </div>
            </div>
        </div>
    </div>
</form>

<script id="datosSeriesArticulo" type="application/json">
    @Html.Raw(JsonSerializer.Serialize(ViewBag.SeriesArticulo, opcionesJson))
</script>

@section Scripts {
    <script src="~/js/articulos.js" asp-append-version="true"></script>
}
