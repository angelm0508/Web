@using System.Text.Json
@model Web.ApiClient.Dtos.SocioNegocio.SocioNegocioCrearDTO
@{
    var opcionesJson = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<div class="modal-header align-items-start">
    <div class="d-flex align-items-start gap-3">
        <span class="d-flex align-items-center justify-content-center rounded-3 flex-shrink-0" style="width:44px;height:44px;background:var(--color-surface-muted);border:1px solid var(--color-border)">
            <i class="fa-solid fa-handshake text-muted"></i>
        </span>
        <div>
            <h5 class="modal-title mb-1">@Model.Nombre</h5>
            <div class="small text-muted font-mono">@Model.Codigo &middot; @(ViewBag.NombreTipoActual ?? "Sin tipo") &middot; @ViewBag.NombreSerieActual</div>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    @if (ViewBag.PuedeVerEstadoCuenta == true)
    {
        var saldoSocio = ViewBag.SaldoSocio as Web.ApiClient.Dtos.EstadoCuenta.SaldoSocioDTO;
        <div class="d-flex align-items-center flex-wrap gap-4 border rounded px-3 py-2 mb-3" id="bloqueSaldoSocio">
            @if (saldoSocio is not null)
            {
                <div>
                    <div class="small text-muted">Saldo</div>
                    <div class="fw-semibold">@saldoSocio.Saldo.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</div>
                </div>
                <div>
                    <div class="small text-muted">Vencido</div>
                    <div class="fw-semibold @(saldoSocio.Vencido > 0 ? "text-danger" : "")">@saldoSocio.Vencido.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</div>
                </div>
            }
            <a class="ms-auto small" href="/EstadoCuenta?codigoSn=@Uri.EscapeDataString(Model.Codigo ?? "")">
                <i class="fa-solid fa-file-invoice-dollar me-1"></i>Ver estado de cuenta
            </a>
        </div>
    }
    @{
        // Solo se carga (en el controlador) para clientes y con permiso de Ver en EstadoCuenta.
        var credito = ViewBag.PosicionCredito as Web.ApiClient.Dtos.CreditoCliente.PosicionCreditoDTO;
        // El flag de ViewBag es dynamic: se pasa a un bool tipado para que el análisis de nulos de «credito» no se pierda.
        var puedeVerCredito = ViewBag.PuedeVerEstadoCuenta is true;
    }
    @if (puedeVerCredito && credito is not null)
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var tieneLimite = credito.Limite.HasValue;
        var excedido = tieneLimite && credito.Exposicion > credito.Limite!.Value;
        // Porcentaje de uso para la barra: con límite 0 (solo contado) cualquier exposición lo excede.
        var porcentaje = !tieneLimite ? 0m
            : credito.Limite!.Value > 0 ? credito.Exposicion / credito.Limite.Value * 100m
            : (credito.Exposicion > 0 ? 100m : 0m);
        var anchoBarra = Math.Max(0m, Math.Min(100m, porcentaje));
        var colorBarra = excedido ? "bg-danger" : (porcentaje >= 80m ? "bg-warning" : "bg-success");
        <div class="border rounded px-3 py-2 mb-3" id="bloqueCreditoSocio">
            <div class="d-flex align-items-center flex-wrap gap-4">
                <div class="fw-semibold"><i class="fa-solid fa-scale-balanced me-1 text-muted"></i>Crédito</div>
                <div>
                    <div class="small text-muted">Límite</div>
                    <div class="fw-semibold">
                        @if (tieneLimite)
                        {
                            @(credito.Limite!.Value.ToString("N2", inv))
                        }
                        else
                        {
                            <span class="text-muted">Sin límite</span>
                        }
                    </div>
                </div>
                <div>
                    <div class="small text-muted">Saldo</div>
                    <div class="fw-semibold">@credito.Saldo.ToString("N2", inv)</div>
                </div>
                <div>
                    <div class="small text-muted">Comprometido</div>
                    <div class="fw-semibold">@credito.Comprometido.ToString("N2", inv)</div>
                </div>
                <div>
                    <div class="small text-muted">Vencido</div>
                    <div class="fw-semibold @(credito.Vencido > 0 ? "text-danger" : "")">@credito.Vencido.ToString("N2", inv)</div>
                </div>
                <div>
                    <div class="small text-muted">Disponible</div>
                    <div class="fw-semibold @(credito.Disponible < 0 ? "text-danger" : "")">
                        @if (credito.Disponible.HasValue)
                        {
                            @(credito.Disponible.Value.ToString("N2", inv))
                        }
                        else
                        {
                            <span class="text-muted">&mdash;</span>
                        }
                    </div>
                </div>
                @if (excedido)
                {
                    <span class="badge text-bg-danger">Excedido</span>
                }
            </div>
            @if (tieneLimite)
            {
                <div class="d-flex align-items-center gap-2 mt-2">
                    <div class="progress flex-grow-1" style="height:8px" role="progressbar" aria-label="Uso del límite de crédito" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(anchoBarra, 0).ToString(inv)">
                        <div class="progress-bar @colorBarra" style="width:@anchoBarra.ToString("0.##", inv)%"></div>
                    </div>
                    <span class="small text-muted text-nowrap">@(credito.Limite!.Value > 0 ? porcentaje.ToString("0.0", inv) + " % del límite" : "Solo contado")</span>
                </div>
            }
        </div>
    }
    <form id="formSocioNegocio" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Serie</label>
                <input class="form-control" value="@ViewBag.NombreSerieActual" disabled />
            </div>
            <div class="col-md-6">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" readonly />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>

            <div class="col-md-6">
                <label asp-for="TipoSn" class="form-label"></label>
                <select asp-for="TipoSn" class="form-select">
                    <option value="">-- Seleccione --</option>
                    <option value="C">Cliente</option>
                    <option value="P">Proveedor</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="GrupoSn" class="form-label"></label>
                <select id="GrupoSn" name="GrupoSn" class="form-select" data-grupo-inicial="@Model.GrupoSn">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="NumLstPrecio" class="form-label"></label>
                <select asp-for="NumLstPrecio" class="form-select" asp-items="ViewBag.ListadosPrecio">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Descuento" class="form-label"></label>
                <input asp-for="Descuento" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="CondicionPago" class="form-label"></label>
                <select asp-for="CondicionPago" class="form-select" asp-items="ViewBag.CondicionesPago">
                    <option value="">Sin condición (usa Contado)</option>
                </select>
            </div>
            @* Solo clientes: el JS los muestra/oculta según el tipo; al guardar se envían siempre (vacío = sin límite). *@
            <div class="col-md-6 campo-credito-cliente @(Model.TipoSn == "C" ? "" : "d-none")">
                <label asp-for="LimiteCredito" class="form-label"></label>
                <input asp-for="LimiteCredito" type="number" min="0" step="0.01" class="form-control" />
                <span class="form-text">Vacío = sin límite; 0 = solo contado</span>
            </div>
            <div class="col-md-6 campo-credito-cliente @(Model.TipoSn == "C" ? "" : "d-none")">
                <label asp-for="BloquearSiVencido" class="form-label">Bloquear si tiene saldo vencido</label>
                <select asp-for="BloquearSiVencido" class="form-select">
                    <option value="N">No</option>
                    <option value="S">Sí</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="Cui" class="form-label"></label>
                <input asp-for="Cui" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Nit" class="form-label"></label>
                <input asp-for="Nit" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="PersContacto" class="form-label"></label>
                <input asp-for="PersContacto" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Tel1" class="form-label"></label>
                <input asp-for="Tel1" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Tel2" class="form-label"></label>
                <input asp-for="Tel2" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Activo" class="form-label"></label>
                <select asp-for="Activo" class="form-select">
                    <option value="S">Sí</option>
                    <option value="N">No</option>
                </select>
            </div>
        </div>
    </form>

    <hr />
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0">Direcciones</h6>
        @if (User.TienePermiso("SociosNegocio", Accion.Agregar))
        {
            <button type="button" class="btn btn-sm btn-outline-primary" id="btnNuevaDireccion">
                <i class="fa-solid fa-plus me-1"></i>Agregar dirección
            </button>
        }
    </div>

    <div class="table-responsive">
        <table id="tblDireccionesSocio" class="table table-sm table-hover align-middle w-100" data-codigo-sn="@Model.Codigo" data-es-edicion="true">
            <thead>
                <tr>
                    <th>Dirección</th>
                    <th>Calle</th>
                    <th>Municipio</th>
                    <th>Departamento</th>
                    <th>Tipo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div id="panelDireccion" class="border rounded p-3 mb-2 d-none">
        <form id="formDireccionSocio">
            <input type="hidden" id="dirDireccionOriginal" value="" />
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label">Código de dirección</label>
                    <input name="Direccion" id="dirCodigo" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Calle</label>
                    <input name="Calle" id="dirCalle" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Bloque</label>
                    <input name="Bloque" id="dirBloque" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Código postal</label>
                    <input name="CodigoPostal" id="dirCodigoPostal" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">País</label>
                    <select name="Pais" id="selectPaisDireccion" class="form-select" asp-items="ViewBag.Paises">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Departamento</label>
                    <select name="Departamento" id="selectDepartamentoDireccion" class="form-select">
                        <option value="">-- Seleccione un país primero --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Municipio</label>
                    <select name="Municipio" id="selectMunicipioDireccion" class="form-select">
                        <option value="">-- Seleccione un departamento primero --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo de dirección</label>
                    <select name="TipoDireccion" id="dirTipoDireccion" class="form-select">
                        <option value="ENV">Envío</option>
                        <option value="FAC">Facturación</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Número de línea</label>
                    <input name="NumLinea" id="dirNumLinea" type="number" class="form-control" />
                </div>
            </div>
            <div class="text-end mt-2">
                <button type="button" class="btn btn-sm btn-secondary" id="btnCancelarDireccion">Cancelar</button>
                <button type="button" class="btn btn-sm btn-primary" id="btnGuardarDireccionLinea">Guardar dirección</button>
            </div>
        </form>
    </div>

    <script id="datosUbicacionDireccion" type="application/json">
        {
            "departamentos": @Html.Raw(JsonSerializer.Serialize(ViewBag.Departamentos, opcionesJson)),
            "municipios": @Html.Raw(JsonSerializer.Serialize(ViewBag.Municipios, opcionesJson))
        }
    </script>

    <script id="datosGruposSocioNegocio" type="application/json">
        @Html.Raw(JsonSerializer.Serialize(ViewBag.GruposSocioNegocio, opcionesJson))
    </script>
</div>
<div class="modal-footer">
    <span class="small text-muted me-auto">Esc para cerrar</span>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
    @if (User.TienePermiso("SociosNegocio", Accion.Actualizar))
    {
        <button type="button" class="btn btn-primary" id="btnGuardarSocioNegocio" data-codigo="@Model.Codigo">
            <i class="fa-solid fa-floppy-disk me-1"></i>Guardar cambios
        </button>
    }
</div>
