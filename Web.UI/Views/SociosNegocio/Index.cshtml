@{
    ViewData["Title"] = "Socios de negocio";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Socios de negocio</h3>
    @if (User.TienePermiso("SociosNegocio", Accion.Agregar))
    {
        <a asp-action="Crear" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i>Nuevo
        </a>
    }
</div>

<div class="card card-modulo">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <div class="btn-group" role="group" aria-label="Filtrar por tipo de socio">
                <input type="radio" class="btn-check" name="filtroTipoSocio" id="filtroTipoTodos" value="" autocomplete="off" checked>
                <label class="btn btn-outline-secondary" for="filtroTipoTodos">Todos</label>
                <input type="radio" class="btn-check" name="filtroTipoSocio" id="filtroTipoClientes" value="C" autocomplete="off">
                <label class="btn btn-outline-secondary" for="filtroTipoClientes">Clientes</label>
                <input type="radio" class="btn-check" name="filtroTipoSocio" id="filtroTipoProveedores" value="P" autocomplete="off">
                <label class="btn btn-outline-secondary" for="filtroTipoProveedores">Proveedores</label>
            </div>
            <select id="filtroSerieSocio" class="form-select w-auto" aria-label="Filtrar por serie">
                <option value="">Todas las series</option>
            </select>
        </div>
        <div class="table-responsive">
            <table id="tblSociosNegocio" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Serie</th>
                        <th>NIT</th>
                        <th>Teléfono</th>
                        <th>Activo</th>
                        <th class="text-end" title="Clientes: por cobrar. Proveedores: por pagar.">Saldo</th>
                        <th class="text-end" title="Parte del saldo con vencimiento anterior a hoy.">Vencido</th>
                        <th class="text-end" title="Solo clientes. «Excedido»: el saldo más lo comprometido en pedidos y entregas abiertos supera el límite.">Límite</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFormulario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="contenidoModal">
            <!-- se carga por AJAX -->
        </div>
    </div>
</div>

<script id="datosSeriesFiltro" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SeriesFiltro ?? new List<object>()).Replace("</", "<\\/"))
</script>

<script id="datosPermisosSociosNegocio" type="application/json">
    { "actualizar": @(User.TienePermiso("SociosNegocio", Accion.Actualizar) ? "true" : "false"),
      "eliminar": @(User.TienePermiso("SociosNegocio", Accion.Eliminar) ? "true" : "false"),
      "verSaldos": @(User.TienePermiso("EstadoCuenta", Accion.Ver) ? "true" : "false") }
</script>

@section Scripts {
    <script src="~/js/sociosNegocio.js" asp-append-version="true"></script>
}
