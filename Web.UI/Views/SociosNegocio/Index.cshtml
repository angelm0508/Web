@{
    ViewData["Title"] = "Socios de negocio";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Socios de negocio</h3>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i>Nuevo
    </a>
</div>

<div class="card card-modulo">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblSociosNegocio" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>NIT</th>
                        <th>Teléfono</th>
                        <th>Activo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalFormulario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="contenidoModal">
            <!-- se carga por AJAX -->
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sociosNegocio.js" asp-append-version="true"></script>
}
