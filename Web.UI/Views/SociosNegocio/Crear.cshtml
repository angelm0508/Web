@using System.Text.Json
@model Web.ApiClient.Dtos.SocioNegocio.SocioNegocioCrearDTO
@{
    ViewData["Title"] = "Nuevo socio de negocio";
    var opcionesJson = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}

<nav class="small text-muted mb-2">
    <a asp-controller="SociosNegocio" asp-action="Index">Socios de negocio</a>
    <i class="fa-solid fa-chevron-right mx-1" style="font-size:.65rem"></i>
    <span>Nuevo socio de negocio</span>
</nav>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
    <div>
        <h1 class="h4 mb-1">Nuevo socio de negocio</h1>
        <p class="text-muted small mb-0">El código y la serie son obligatorios <span class="text-danger">*</span> para poder registrarlo.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="SociosNegocio" asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar</a>
        <button type="button" class="btn btn-primary btn-sm" id="btnGuardarSocioNegocioPagina">
            <i class="fa-solid fa-check me-1"></i>Guardar socio
        </button>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabGeneral" type="button">General</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabContacto" type="button">Contacto</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabComercial" type="button">Comercial</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDirecciones" type="button">Direcciones</button>
    </li>
</ul>

<form id="formSocioNegocioCrear" novalidate>
<div class="row g-3">
    <div class="col-lg-8">
        <div class="tab-content">
                <div class="tab-pane fade show active" id="tabGeneral">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h6 mb-1">Identificación</h2>
                            <p class="small text-muted mb-3">Cómo se llama y cómo se encuentra este socio en el sistema.</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Serie <span class="text-danger">*</span></label>
                                    <select id="selectSerieSocioNegocio" class="form-select">
                                        <option value="">-- Seleccione el tipo primero --</option>
                                    </select>
                                    <span class="form-text">Si eliges una serie distinta de "Manual", el código se genera solo al guardar.</span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Codigo" class="form-label"></label> <span class="text-danger">*</span>
                                    <input asp-for="Codigo" class="form-control" />
                                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Activo" class="form-label"></label>
                                    <select asp-for="Activo" class="form-select">
                                        <option value="S">Sí</option>
                                        <option value="N">No</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Nombre" class="form-label"></label>
                                    <input asp-for="Nombre" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="TipoSn" class="form-label"></label>
                                    <select asp-for="TipoSn" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                        <option value="C">Cliente</option>
                                        <option value="P">Proveedor</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="GrupoSn" class="form-label"></label>
                                    <select id="GrupoSn" name="GrupoSn" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tabContacto">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h6 mb-1">Contacto</h2>
                            <p class="small text-muted mb-3">Identificación fiscal y datos para comunicarse con el socio.</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="Cui" class="form-label"></label>
                                    <input asp-for="Cui" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Nit" class="form-label"></label>
                                    <input asp-for="Nit" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="PersContacto" class="form-label"></label>
                                    <input asp-for="PersContacto" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Tel1" class="form-label"></label>
                                    <input asp-for="Tel1" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Tel2" class="form-label"></label>
                                    <input asp-for="Tel2" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" type="email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tabComercial">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h6 mb-1">Comercial</h2>
                            <p class="small text-muted mb-3">Condiciones de precio aplicables a este socio.</p>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="NumLstPrecio" class="form-label"></label>
                                    <select asp-for="NumLstPrecio" class="form-select" asp-items="ViewBag.ListadosPrecio">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Descuento" class="form-label"></label>
                                    <input asp-for="Descuento" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tabDirecciones">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h2 class="h6 mb-0">Direcciones</h2>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnNuevaDireccion">
                                    <i class="fa-solid fa-plus me-1"></i>Agregar dirección
                                </button>
                            </div>
                            <p class="small text-muted mb-3">Las direcciones agregadas aquí se guardarán junto con el socio.</p>

                            <div class="table-responsive">
                                <table id="tblDireccionesSocio" class="table table-sm table-hover align-middle w-100" data-codigo-sn="" data-es-edicion="false">
                                    <thead>
                                        <tr>
                                            <th>Dirección</th>
                                            <th>Calle</th>
                                            <th>Municipio</th>
                                            <th>Departamento</th>
                                            <th>Tipo</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>

                            <div id="panelDireccion" class="border rounded p-3 mb-2 d-none">
                                <div id="formDireccionSocio">
                                    <input type="hidden" id="dirDireccionOriginal" value="" />
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label">Código de dirección</label>
                                            <input name="Direccion" id="dirCodigo" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Calle</label>
                                            <input name="Calle" id="dirCalle" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Bloque</label>
                                            <input name="Bloque" id="dirBloque" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">Código postal</label>
                                            <input name="CodigoPostal" id="dirCodigoPostal" class="form-control" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">País</label>
                                            <select name="Pais" id="selectPaisDireccion" class="form-select" asp-items="ViewBag.Paises">
                                                <option value="">-- Seleccione --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Departamento</label>
                                            <select name="Departamento" id="selectDepartamentoDireccion" class="form-select">
                                                <option value="">-- Seleccione un país primero --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Municipio</label>
                                            <select name="Municipio" id="selectMunicipioDireccion" class="form-select">
                                                <option value="">-- Seleccione un departamento primero --</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Tipo de dirección</label>
                                            <select name="TipoDireccion" id="dirTipoDireccion" class="form-select">
                                                <option value="ENV">Envío</option>
                                                <option value="FAC">Facturación</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Número de línea</label>
                                            <input name="NumLinea" id="dirNumLinea" type="number" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="text-end mt-2">
                                        <button type="button" class="btn btn-sm btn-secondary" id="btnCancelarDireccion">Cancelar</button>
                                        <button type="button" class="btn btn-sm btn-primary" id="btnGuardarDireccionLinea">Guardar dirección</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 mb-2">Recomendado completar</h2>
                    <div class="d-flex flex-column gap-2 small" id="listaChecklistSocio">
                        <div class="d-flex align-items-center gap-2" data-check="Nombre">
                            <i class="fa-regular fa-circle text-muted"></i><span>Nombre</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" data-check="TipoSn">
                            <i class="fa-regular fa-circle text-muted"></i><span>Tipo (Cliente/Proveedor)</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" data-check="GrupoSn">
                            <i class="fa-regular fa-circle text-muted"></i><span>Grupo</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" data-check="Email">
                            <i class="fa-regular fa-circle text-muted"></i><span>Correo</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" data-check-direccion="true">
                            <i class="fa-regular fa-circle text-muted"></i><span>Al menos una dirección</span>
                        </div>
                    </div>
                    <p class="small text-muted mt-3 mb-0">Puedes guardar sin completarlos; quedan pendientes para después.</p>
                </div>
            </div>
        </div>
    </div>
</div>
</form>

<script id="datosUbicacionDireccion" type="application/json">
    {
        "departamentos": @Html.Raw(JsonSerializer.Serialize(ViewBag.Departamentos, opcionesJson)),
        "municipios": @Html.Raw(JsonSerializer.Serialize(ViewBag.Municipios, opcionesJson))
    }
</script>

<script id="datosGruposSocioNegocio" type="application/json">
    @Html.Raw(JsonSerializer.Serialize(ViewBag.GruposSocioNegocio, opcionesJson))
</script>

<script id="datosSeriesSocioNegocio" type="application/json">
    @Html.Raw(JsonSerializer.Serialize(ViewBag.SeriesSocioNegocio, opcionesJson))
</script>

@section Scripts {
    <script src="~/js/sociosNegocio.js" asp-append-version="true"></script>
}
